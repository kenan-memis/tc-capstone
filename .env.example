# Copy this file to `.env` and set your API keys.
# Do not commit `.env` to version control.

# Same variable names as Sprint 2 PlanMyBerlin — use identical names in
# Google Cloud Secret Manager and map them to Cloud Run env vars.

OPENAI_API_KEY=

# Gemini (trip profile / optional models): either is accepted by Sprint 2 code paths
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional: other keys as you add integrations
OPENWEATHER_API_KEY=
SERPAPI_API_KEY=
GOOGLE_PLACES_API_KEY=